<settings xmlns="http://maven.apache.org/SETTINGS/1.3.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.3.0
                      https://maven.apache.org/xsd/settings-1.3.0.xsd">
  <servers>
    <server>
      <!-- Token obtained from https://central.sonatype.com/account, see Guide: https://central.sonatype.org/publish/generate-portal-token/ -->
      <id>sonatype-publishing</id>
      <username>${env.SONATYPE_USERTOKEN}</username>
      <password>${env.SONATYPE_USERTOKENPASSWORD}</password>
      <repositoryOrigins>
        <repositoryOrigin>https://central.sonatype.com</repositoryOrigin>
      </repositoryOrigins>
    </server>
    <server>
      <id>gpg.passphrase</id>
      <passphrase>${env.GPG_PASSPHRASE}</passphrase>
    </server>
  </servers>
</settings>
